ORCHESTRATOR_HOST=127.0.0.1
ORCHESTRATOR_PORT=8000
MCP_PORT=8765
SQLITE_FILENAME=orchestrator.db
# Create this key in the Muse4AI desktop app > Settings > API & agent (msk_...)
MUSE4AI_API_KEY=
# Muse4AI runs locally on this same PC; change the port only if you changed
# it in the app's settings
MUSE4AI_BASE_URL=http://127.0.0.1:47821/v1
ANTIGRAVITY_CLI_PATH=agy

# Publisher Agent (YouTube/TikTok/Instagram) — see agents/publisher/README.md
# YouTube: filename only (relative to config/), created by scripts/setup_youtube_oauth.py
YOUTUBE_TOKEN_FILENAME=youtube_token.json
# TikTok: access token from that app's own OAuth consent (developers.tiktok.com)
TIKTOK_ACCESS_TOKEN=
# Instagram: Page/User access token with content-publishing permission, and
# the Instagram Business Account id linked to that Page (developers.facebook.com)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_IG_USER_ID=
DASHBOARD_JWT_SECRET=
DASHBOARD_PASSWORD=
DASHBOARD_TOKEN_TTL_SECONDS=43200
MAX_CONCURRENT_TASKS=3
MAX_TASK_TIMEOUT_SECONDS=1800
MAX_FIX_RETRIES=3
