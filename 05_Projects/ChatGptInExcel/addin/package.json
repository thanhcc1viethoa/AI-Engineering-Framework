{
  "name": "chatgpt-in-excel-addin",
  "version": "0.1.0",
  "private": true,
  "description": "Personal Excel add-in for ChatGPT integration.",
  "scripts": {
    "certs": "office-addin-dev-certs install",
    "start": "node server.js",
    "validate": "office-addin-manifest validate manifest.xml",
    "excel": "office-addin-debugging start manifest.xml desktop",
    "stop": "office-addin-debugging stop manifest.xml"
  },
  "dependencies": {
    "office-addin-dev-certs": "^2.0.9"
  },
  "devDependencies": {
    "office-addin-debugging": "^6.1.1",
    "office-addin-manifest": "^2.1.5"
  }
}
